# Строки для .env стенда (~/stand/.env). Файл .env в репозиторий не кладётся.
# В COLLECTOR_USER_AGENT замените адрес на свою почту: источник просит контакт.
VARIANT=27
SOURCE=sensors
SOURCE_FILTER=PL,CZ,AT
# Способ описания схемы события (ЛР2).
SERDE=avro
COMPOSE_FILE=compose.yaml
COLLECTOR_MODE=record
COLLECTOR_RAW_LIMIT_GB=20

COLLECTOR_USER_AGENT=bigdata-stand-collector/27 (CHANGE_ME@example.com)
COLLECTOR_POLL_SECONDS=300
COLLECTOR_COUNTRY_URL=https://data.sensor.community/airrohr/v1/filter/country={country}
COLLECTOR_GLOBAL_URL=https://data.sensor.community/static/v2/data.json
COLLECTOR_ARCHIVE_URL=https://archive.sensor.community/{date}/{date}_{slug}_sensor_{sensor_id}{suffix}.csv

# Одни сутки до начала записи. TO позже FROM и в период не входит.
# Если запись потока начнётся в другой день — поставьте сутки перед ней.
COLLECTOR_HISTORY_FROM=2026-10-09
COLLECTOR_HISTORY_TO=2026-10-10
